# Copy this file to `.env` and fill in the values.

# --- Database (Supabase Postgres) ---
# From your Supabase project: Settings → Database → Connection string.
#
# DATABASE_URL = the POOLED connection (Transaction pooler, port 6543).
#   Append ?pgbouncer=true so Prisma disables prepared statements.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# DIRECT_URL = the DIRECT connection (port 5432). Used for migrations / schema push.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Admin dashboard login ---
ADMIN_EMAIL="admin@edgbastoncollege.co.uk"
ADMIN_PASSWORD="change-me"

# --- Session ---
# A long, random secret used to sign the admin session cookie.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET="please-change-this-to-a-long-random-string"

# --- Media uploads (Supabase Storage) ---
# Enables uploading VIDEO and PDF files from the rich-text editor. Create a
# PUBLIC bucket named "media" in Supabase → Storage, then fill these in.
# Keys are in Supabase → Settings → API. Leave blank to disable file uploads
# (the editor keeps working; the Video/PDF buttons just show a setup notice).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon public key>"
SUPABASE_SERVICE_ROLE_KEY="<service role secret key>"
