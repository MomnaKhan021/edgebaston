// Prisma schema for the Edgebaston College CMS.
// Uses PostgreSQL on Supabase. Set DATABASE_URL to the Supabase *pooled*
// connection string (Supavisor, port 6543, with ?pgbouncer=true) used at
// runtime, and DIRECT_URL to the *direct* connection (port 5432) used for
// migrations / schema push.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A course offered by the college. Description/overview are rich-text HTML
/// produced by the dashboard editor.
model Course {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  category      String   @default("General")
  level         String   @default("Undergraduate")
  duration      String   @default("")
  fee           String   @default("")
  summary       String   @default("") // short plain-text blurb for cards
  content       String   @default("") // rich-text HTML for the detail page
  imageUrl      String   @default("")
  redirectUrl   String   @default("") // if set, the public course page 307-redirects here
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Staff / faculty / admin member.
model Staff {
  id         String   @id @default(cuid())
  name       String
  role       String   @default("")
  department String   @default("")
  category   String   @default("Faculty") // Faculty | Admin | Support
  email      String   @default("")
  phone      String   @default("")
  bio        String   @default("") // rich-text HTML
  photoUrl   String   @default("")
  published  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// A flexible content page the client can create/edit from the dashboard
/// (e.g. "Admissions", "Campus Life"). Rendered at /<slug> (root), where the
/// slug may contain slashes for nested paths (e.g. "guard/course" → /guard/course).
/// Editable content for one section of a page template (e.g. the home-page
/// hero). `data` is a JSON object of field values; fields are defined in
/// src/lib/templates.ts and merged over code defaults at render time.
model TemplateSection {
  id        String   @id @default(cuid())
  template  String   @default("home")
  key       String
  data      String   @default("{}")
  updatedAt DateTime @updatedAt

  @@unique([template, key])
}

model Page {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @default("") // rich-text HTML
  templateKey String   @default("") // if set, the page renders this designed template (its content lives under "inst_<id>")
  metaTitle       String @default("") // SEO <title>; falls back to the page title
  metaDescription String @default("") // SEO meta description; falls back to a content excerpt
  redirectUrl String   @default("") // if set, the public page 307-redirects here
  showInNav   Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Blog / news article ("Suite Talk"-style listing + branded article page).
model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String   @default("") // short blurb for the listing cards
  content     String   @default("") // rich-text HTML for the article body
  metaTitle       String @default("") // SEO <title>; falls back to the post title
  metaDescription String @default("") // SEO meta description; falls back to the excerpt
  category    String   @default("") // e.g. Implants, Orthodontics — drives the filter tabs
  imageUrl    String   @default("")
  authorName  String   @default("")
  authorImage String   @default("")
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Contact form submissions from the public site.
model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  subject   String   @default("")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Single-row site-wide settings (branding, contact info, hero copy).
model SiteSetting {
  id           Int      @id @default(1)
  siteName     String   @default("Edgebaston College")
  tagline      String   @default("Shaping futures through education")
  heroTitle    String   @default("Welcome to Edgebaston College")
  heroSubtitle String   @default("A community of learners committed to academic excellence.")
  heroImageUrl String   @default("")
  aboutText    String   @default("") // rich-text HTML
  email        String   @default("info@edgebaston.edu")
  phone        String   @default("+44 121 000 0000")
  address      String   @default("Edgbaston, Birmingham, UK")
  primaryColor String   @default("#1e3a5f")
  accentColor  String   @default("#c9a227")
  // SEO / metadata (shown in search results and browser tabs)
  metaTitle       String @default("") // <title> / og:title; falls back to site name + tagline
  metaDescription String @default("") // meta description; falls back to tagline
  faviconUrl      String @default("") // browser-tab icon (data URI or path)
  updatedAt    DateTime @updatedAt
}
